# 复制为 refactor-app/.env.ohmycaptcha 后再编辑

# 服务监听
OHMYCAPTCHA_HOST=127.0.0.1
OHMYCAPTCHA_PORT=18000

# 和 refactor-app/.env 里 PERSONAL_PLUS_CHECKOUT_CAPTCHA_CLIENT_KEY 保持一致
CLIENT_KEY=a31b658c0323af809779608a8e2e651f

# 二选一：云端 OpenAI-compatible 模型
# CLOUD_BASE_URL=https://your-openai-compatible-endpoint/v1
# CLOUD_API_KEY=your_api_key
# CLOUD_MODEL=gpt-4.1-mini

# 或本地 OpenAI-compatible 模型
# LOCAL_BASE_URL=http://127.0.0.1:1234/v1
# LOCAL_API_KEY=local_key
# LOCAL_MODEL=qwen2.5-vl-7b-instruct
